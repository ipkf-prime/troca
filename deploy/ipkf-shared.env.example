APP_NAME=IPKF Framework
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran

# Domains are deployment data, never application identifiers.
CORE_APP_URL=https://core.example.test
AUTOMATION_APP_URL=https://automation.example.test
WORK_APP_URL=https://work.example.test
ALLOWED_APP_HOSTS=core.example.test,automation.example.test,work.example.test
APP_HOST_GUARD_ENABLED=true

AUTH_SESSION_NAME=ipkf_development_shared
AUTH_SESSION_LIFETIME=7200
AUTH_COOKIE_DOMAIN=.example.test
AUTH_COOKIE_SECURE=true

SITE_MODE=coming_soon
IPKF_INSTALLED=false
IDENTITY_DEV_EXPOSE_TOKEN=false
DEV_MAINTENANCE_KEY=

ADMIN_BRAND_NAME=IPKF
ADMIN_LOGO_URL=/assets/admin/images/logos/default-logo.svg
ADMIN_DEFAULT_AVATAR_URL=/assets/admin/images/avatars/default-avatar.svg
ADMIN_FONT_FAMILY=Vazirmatn
ADMIN_NAME=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_MOBILE=
ADMIN_PASSWORD=

DB_CONNECTION=mysql
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
DB_PORT=3306

AUTOMATION_DB_HOST=localhost
AUTOMATION_DB_PORT=3306
AUTOMATION_DB_DATABASE=
AUTOMATION_DB_USERNAME=
AUTOMATION_DB_PASSWORD=
AUTOMATION_DB_CHARSET=utf8mb4
AUTOMATION_DB_SSL_MODE=
AUTOMATION_DB_CONNECTION_TIMEOUT=10
AUTOMATION_DB_MODE=fallback

WORK_DB_HOST=localhost
WORK_DB_PORT=3306
WORK_DB_DATABASE=
WORK_DB_USERNAME=
WORK_DB_PASSWORD=
WORK_DB_CHARSET=utf8mb4
WORK_DB_SSL_MODE=
WORK_DB_CONNECTION_TIMEOUT=10
WORK_DB_MODE=fallback

PRIVATE_FILE_STORAGE_PATH=/home/account/apps/ipkf/shared/private

MFA_ENABLED=true
MFA_ENFORCEMENT=optional
MFA_EMAIL_ENABLED=false
MFA_SMS_ENABLED=false
MFA_BOT_ENABLED=false
MFA_DEV_EXPOSE_OTP=false

MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=IPKF

SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
MESSENGER_DRIVER=

BOT_PROVIDER=bale
BALE_BOT_TOKEN=
BALE_API_BASE_URL=
INTERNAL_SERVICE_KEY=
