# Each deployed module keeps only this descriptor locally.
# The referenced absolute path must be outside every public document root.
IPKF_SHARED_ENV=/home/account/config/ipkf-development.env
IPKF_MODULE=core

# The following values are local-development defaults. Production values belong
# in IPKF_SHARED_ENV and are shared by all module deployments.
APP_NAME=IPKF Framework
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran
# Optional non-module hosts only. Active module hosts come from the registry.
ALLOWED_APP_HOSTS=
DB_CONNECTION=mysql
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
DB_PORT=3306
AUTOMATION_DB_HOST=
AUTOMATION_DB_PORT=3306
AUTOMATION_DB_DATABASE=
AUTOMATION_DB_USERNAME=
AUTOMATION_DB_PASSWORD=
AUTOMATION_DB_CHARSET=utf8mb4
AUTOMATION_DB_SSL_MODE=
AUTOMATION_DB_CONNECTION_TIMEOUT=5
AUTOMATION_DB_MODE=fallback
WORK_DB_HOST=
WORK_DB_PORT=3306
WORK_DB_DATABASE=
WORK_DB_USERNAME=
WORK_DB_PASSWORD=
WORK_DB_CHARSET=utf8mb4
WORK_DB_SSL_MODE=
WORK_DB_CONNECTION_TIMEOUT=5
WORK_DB_MODE=fallback
DEV_MAINTENANCE_KEY=change-me
IPKF_INSTALLED=false
SITE_MODE=coming_soon
ADMIN_BRAND_NAME=سامانه هوشمند تروکا
ADMIN_LOGO_URL=/assets/admin/images/logos/default-logo.svg
ADMIN_DEFAULT_AVATAR_URL=/assets/admin/images/avatars/default-avatar.svg
ADMIN_FONT_FAMILY=Vazirmatn
ADMIN_NAME=Super Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_MOBILE=
ADMIN_PASSWORD=change-me-securely
PRIVATE_FILE_STORAGE_PATH=

# Shared private-file infrastructure.
# Admin app_settings overrides these values when configured.
IPKF_PRIVATE_FILE_STORAGE_PATH=
IPKF_MALWARE_CLAMSCAN_PATH=
IPKF_MALWARE_SCAN_TIMEOUT_SECONDS=45
MFA_ENABLED=true
MFA_ENFORCEMENT=optional
MFA_EMAIL_ENABLED=false
MFA_SMS_ENABLED=false
MFA_BOT_ENABLED=false
MFA_DEV_EXPOSE_OTP=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=IPKF
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
BOT_PROVIDER=bale
BALE_BOT_TOKEN=
BALE_API_BASE_URL=
INTERNAL_SERVICE_KEY=
IDENTITY_DEV_EXPOSE_TOKEN=false
# Master key for encrypting notification-provider credentials.
# Generate once per installation. Never commit or store the value in the database.
NOTIFICATION_SECRET_KEY=
# Automation correspondence attachment policy.
# Values outside the supported safe bounds fall back to defaults.
AUTOMATION_ATTACHMENT_MAX_FILES=3
AUTOMATION_ATTACHMENT_MAX_FILE_MB=10
AUTOMATION_ATTACHMENT_MAX_TOTAL_MB=20
AUTOMATION_ATTACHMENT_ALLOWED_EXTENSIONS=pdf,docx,jpg,jpeg,png
AUTOMATION_ATTACHMENT_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png
# Inactive correspondence attachment lifecycle
AUTOMATION_ATTACHMENT_RETENTION_DAYS=30
AUTOMATION_ATTACHMENT_PURGE_BATCH_SIZE=100
# Automation correspondence attachment malware scanning
AUTOMATION_ATTACHMENT_CLAMSCAN_PATH=/usr/local/cpanel/3rdparty/bin/clamscan
AUTOMATION_ATTACHMENT_SCAN_TIMEOUT_SECONDS=45
AUTOMATION_ATTACHMENT_LEGACY_SCAN_BATCH_SIZE=10

DEPLOYMENT_ID=local_development
CORE_APP_URL=http://localhost
AUTOMATION_APP_URL=http://oa.localhost
WORK_APP_URL=http://work.localhost
TICKETING_APP_URL=http://ticketing.localhost
APP_HOST_GUARD_ENABLED=false
AUTH_SESSION_NAME=ipkf_session
AUTH_SESSION_LIFETIME=7200
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_HTTPONLY=true
AUTH_COOKIE_SAMESITE=Lax
